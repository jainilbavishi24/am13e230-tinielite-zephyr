  },
  "input": {
    "shape": [1, 1, 256, 1],
    "dtype": "int8",
    "size_bytes": 256,
    "runtime_field": "onnx__Add_0"
  },
  "output": {
    "shape": [1, 3],
    "dtype": "int8",
    "size_bytes": 3,
    "runtime_field": "output",
    "labels": ["Sawtooth", "Sine", "Square"]
  },
  "preprocessing": {
    "type": "ti_affine_shift_header",
    "bias_symbol": "tvmgen_default_bias_data",
    "scale_symbol": "tvmgen_default_scale_data",
    "shift_symbol": "tvmgen_default_shift_data"
  },
  "golden_vectors": {
    "format": "ti_c_arrays_v1",
    "path": "golden_vectors/test_vector.c",
    "input_array": "model_test_input",
    "output_array": "golden_output"
  },
  "io_alignment": 16
}
