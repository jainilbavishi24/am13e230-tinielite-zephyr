{
  "schema_version": 1,
  "name": "waveform_classifier",
  "display_name": "Waveform classifier",
  "model_id": "0xc7d11096",
  "target": {
    "device_family": "AM13E2",
    "accelerator": "TINIElite",
    "requires_npu": true
  },
  "artifacts": {
